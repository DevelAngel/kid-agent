# Copy to /etc/kid-agent/kid-agent.env (referenced by
# kid-agent.service) and fill in real values. Keep permissions
# restrictive (e.g. 0600, owned by the service user) since this holds
# secrets.

KID_AGENT_HOMESERVER=matrix.example.com
KID_AGENT_DEVICE_NAME=relay-daemon
KID_AGENT_USERNAME=relay-bot
KID_AGENT_PASSWORD=changeme
KID_AGENT_RECOVERY_KEY=changeme
KID_AGENT_STATE_DIR=/var/lib/kid-agent/state
KID_AGENT_ROOM_ID=!abcdef:example.com
KID_AGENT_GENERATE_URL=http://127.0.0.1:8001/mcp
KID_AGENT_GENERATE_CLIENT_ID=changeme
KID_AGENT_GENERATE_CLIENT_SECRET=changeme
KID_AGENT_LLM_API_BASE_URL=http://localhost:8000/v1
