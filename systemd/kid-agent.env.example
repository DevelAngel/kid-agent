# Copy to /etc/kid-agent/kid-agent.env (referenced by
# kid-agent.service) and fill in real values. Keep permissions
# restrictive (e.g. 0600, owned by the service user) since this holds
# secrets.

MATRIX_HOMESERVER=matrix.example.com
MATRIX_DEVICE_NAME=relay-daemon
MATRIX_USERNAME=relay-bot
MATRIX_PASSWORD=changeme
MATRIX_RECOVERY_KEY=changeme
MATRIX_STATE_DIR=/var/lib/kid-agent/state
MATRIX_ROOM_ID=!abcdef:example.com
MATRIX_GENERATE_URL=http://127.0.0.1:8001/mcp
MATRIX_GENERATE_CLIENT_ID=changeme
MATRIX_GENERATE_CLIENT_SECRET=changeme
MATRIX_LLM_API_BASE_URL=http://localhost:8000/v1
